<?xml version="1.0" encoding="utf-8"?>
<!-- Block automatic backup of credentials, caches, and local overrides. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="bmu_credentials.xml" />
        <exclude domain="sharedpref" path="bmu_snapshot.xml" />
        <exclude domain="sharedpref" path="bmu_timetable.xml" />
        <exclude domain="sharedpref" path="bmu_attendance_theme.xml" />
        <exclude domain="file" path="venue_overrides.json" />
        <exclude domain="file" path="subject_aliases.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="bmu_credentials.xml" />
        <exclude domain="sharedpref" path="bmu_snapshot.xml" />
        <exclude domain="sharedpref" path="bmu_timetable.xml" />
        <exclude domain="sharedpref" path="bmu_attendance_theme.xml" />
        <exclude domain="file" path="venue_overrides.json" />
        <exclude domain="file" path="subject_aliases.json" />
    </device-transfer>
</data-extraction-rules>
